# --- server ---
PORT=3000
NODE_ENV=development
# set to 1 behind HTTPS (production)
COOKIE_SECURE=0

# --- database ---
DATABASE_URL=postgres://scopeguard:scopeguard@localhost:5432/scopeguard

# --- model ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Routing through a proxy puts a third party in the path of every pasted
# contract. Leave empty to talk to OpenAI directly; if set, the privacy notice
# has to name that proxy as a processor (spec §7).
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
# Reasoning models only — leave empty for models that reject the parameter.
OPENAI_REASONING_EFFORT=
# hard stop for a single check, ms
LLM_TIMEOUT_MS=30000

# --- budget guard ---
# free checks per visitor, matched on (email, cookie). Not stated anywhere in
# the interface, so this number moves without a copy change.
FREE_CHECKS=5
# refuse new checks after this many per UTC day (0 = no cap)
DAILY_CHECK_CAP=300
# Your provider's tariff per 1M tokens, used only for cost logging. Leave empty
# and cost is reported as null — better than a confident wrong number. Take the
# figures from your provider's pricing page, including any proxy markup.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PRICE_CURRENCY=RUB

# --- pricing screen (subject to change, never hardcode in markup) ---
PLAN_PRICE=$19
PLAN_PERIOD=month

# --- analytics ---
# leave empty to disable GA4 entirely
GA4_MEASUREMENT_ID=
